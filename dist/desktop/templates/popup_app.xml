<?xml version="1.0" encoding="UTF-8"?>
<!--
  popup_app.xml — OWL template for PopupApp.
  Compile: bash scripts/compile-templates.sh
  NOTE: All expressions are JavaScript, not Python.
-->
<templates xml:space="preserve">

  <t t-name="PopupApp">
    <div class="app-root">

      <!-- Loading -->
      <div id="loader-container"
        t-att-class="state.view === 'loading' ? '' : 'hide'">
        <div class="loader-card">
          <div class="loader-text"><t t-esc="state.busyMessage"/></div>
          <div class="loader-subtext">Please wait — or grab a cup of coffee ☕</div>
          <i class="fa fa-cog fa-spin fa-5x"/>
        </div>
      </div>

      <!-- Login -->
      <div id="login" class="login-view"
        t-att-class="state.view === 'login' ? '' : 'hide'">
        <div class="popup-login-shell">
          <div class="form">
            <div class="logo"><img t-att-src="currentRemoteLogoSrc" alt="Remote logo"/></div>
            <t t-if="state.bootError">
              <div><p class="odooError"><t t-esc="state.bootError"/></p></div>
            </t>
            <t t-if="!state.remotes.length">
              <div class="container no-remotes-set">
                <div class="alert alert-warning">
                  Hello <span class="fun-man">😉</span>, you have not configured any
                  remotes. Open <b><i class="fa fa-cogs"/> Options</b> below and add one.
                </div>
              </div>
            </t>
            <t t-if="state.remotes.length">
              <form t-on-submit.prevent="login">
                <t t-if="state.loginError">
                  <p class="odooError"><t t-esc="state.loginError"/></p>
                </t>
                <t t-if="!state.useExistingSession">
                  <input type="text" placeholder="Username"
                    t-att-value="state.username"
                    t-on-input="(ev) => { state.username = ev.target.value; }"/>
                  <div class="password-field">
                    <input t-att-type="state.showPassword ? 'text' : 'password'"
                      id="unique-password" placeholder="Password"
                      t-att-value="state.password"
                      t-on-input="(ev) => { state.password = ev.target.value; }"/>
                    <span class="pass-viewer" t-on-click.prevent="togglePassword">
                      <i class="fa"
                        t-att-class="state.showPassword ? 'fa-eye-slash' : 'fa-eye'"/>
                    </span>
                  </div>
                </t>
                <select id="remote-selection" class="form-control"
                  t-on-change="(ev) => { state.selectedRemoteIndex = ev.target.value; }">
                  <t t-foreach="state.remotes" t-as="remote"
                    t-key="remoteKey(remote)">
                    <option t-att-value="'' + remote_index"
                      t-att-selected="state.selectedRemoteIndex === '' + remote_index">
                      <t t-esc="remoteOptionLabel(remote)"/>
                    </option>
                  </t>
                </select>
                <div class="checkbox">
                  <label>
                    <input type="checkbox"
                      t-att-checked="state.useExistingSession"
                      t-on-change="toggleUseExistingSession"/>
                    Use Existing Session
                  </label>
                </div>
                <button class="login" type="submit">
                  Login
                  <t t-if="state.loginLoading"><i class="fa fa-cog fa-spin"/></t>
                </button>
                <t t-if="currentRemote">
                  <div class="remote-info small-note">
                    Host: <t t-esc="currentRemote.url"/>
                    <span class="current-source-chip">
                      <t t-esc="currentRemote.datasrc || 'project.issue'"/>
                    </span>
                  </div>
                </t>
              </form>
            </t>
          </div>
        </div>
        <div class="cta forgotpwd footer-app-opts login-footer-bar">
          <a href="options_main_page.html"><i class="fa fa-cogs"/> Options</a>
        </div>
      </div>

      <!-- Main -->
      <div id="wrapper" t-att-class="state.view === 'main' ? '' : 'hide'">
        <t t-if="state.sourceError">
          <div class="odooError source-warning"><t t-esc="state.sourceError"/></div>
        </t>
        <div class="toolbar-row">
          <input id="searchIssue" type="text"
            placeholder="Search by ID, name, user, priority, stage..."
            t-att-value="state.searchQuery"
            t-on-input="(ev) => { state.searchQuery = ev.target.value; }"/>
          <t t-if="isHelpdeskSource">
            <select id="stageFilter" t-att-value="state.stageFilter"
              t-on-change="(ev) => updateStageFilter(ev.target.value)">
              <option value="">All stages</option>
              <t t-foreach="stageOptions || []" t-as="stage" t-key="stage.id">
                <option t-att-value="'' + stage.id"
                  t-att-selected="state.stageFilter === '' + stage.id">
                  <t t-esc="stage.name"/>
                </option>
              </t>
            </select>
          </t>
          <select id="limitTo" t-att-value="state.limitTo"
            t-on-change="(ev) => updateLimitPreference(ev.target.value)">
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="25">25</option>
            <option value="">All</option>
          </select>
        </div>

        <div class="container footer top-actions">
          <div class="auto_download_timesheet"
            title="Store timesheet locally when you stop timer on the current item">
            <input id="auto_download_timesheet_input" type="checkbox"
              t-att-checked="state.autoDownloadIssueTimesheet"
              t-on-change="toggleAutoDownload"/>
            Auto Download Current Item Timesheet
          </div>
          <div class="row">
            <div class="mx-3 col-md-12 footer-btns pointer">
              <i class="fa fa-download fa-2x" title="Download current month timesheet"
                t-on-click="downloadCurrentMonthTimesheets"/>
              <i class="fa fa-hand-o-left fa-2x" title="Switch between remotes"
                t-on-click="switchBetweenRemotes"/>
              <i class="fa fa-refresh fa-2x" title="Refresh current items"
                t-on-click="refreshAll"/>
              <i class="fa fa-clock-o fa-2x" title="Discard the active timer"
                t-on-click="resetTimer"/>
              <i class="fa fa-sign-out fa-2x" title="Log out" t-on-click="logout"/>
              <i class="fa fa-video-camera fa-2x" title="Record screen"
                t-on-click="toggleRecording"/>
              <span class="msg-icon-wrap" title="Open Messages" t-on-click="openMessages">
                <i class="fa fa-comments fa-2x"/>
                <span class="msg-unread-badge"
                  t-att-style="(state.msgUnreadTotal || 0) > 0 ? '' : 'display:none'">
                  <t t-esc="(state.msgUnreadTotal || 0) > 99 ? '99+' : '' + (state.msgUnreadTotal || '')"/>
                </span>
              </span>
              <i class="fa fa-bug fa-2x logs-btn" title="View Logs" t-on-click="openLogs"/>
              <a href="options_main_page.html" class="options-btn" title="Options">
                <i class="fa fa-cogs fa-2x"/>
              </a>
            </div>
          </div>
        </div>

        <div class="table-scroll">
          <table class="table table-responsive-sm table-bordered table-fixed"
            id="table-task-issues">
            <thead>
              <tr>
                <th class="action-col">
                  <div>
                    <t t-if="state.timerStartIso">
                      <span class="startTimeCount"><t t-esc="formattedTimer"/></span>
                    </t>
                  </div>
                </th>
                <t t-if="isHelpdeskSource">
                  <t t-if="showHelpdeskTherpLink">
                    <th class="text-center" style="width:72px">Therp Task</th>
                  </t>
                  <th class="priority-col">Priority</th>
                  <th class="item-col" style="width:280px">
                    <div class="item-header-title">
                      <t t-esc="itemLabelPlural"/>
                      [<t t-esc="'' + filteredIssues.length"/>]
                    </div>
                    <label class="allIssues">
                      <input id="showAllIssues" type="checkbox"
                        t-att-checked="state.allIssues"
                        t-on-input="(ev) => updateShowAllPreference(ev.target.checked)"/>
                      Show for everyone
                    </label>
                  </th>
                  <th class="stage-col">Stage</th>
                  <t t-if="showHelpdeskAssignee">
                    <th style="width:120px">Assigned To</th>
                  </t>
                  <t t-if="showHelpdeskHours">
                    <th style="width:88px">Time Spent</th>
                  </t>
                </t>
                <t t-else="">
                  <th class="priority-col">Priority</th>
                  <th class="stage-col">Stage</th>
                  <th class="item-col">
                    <div class="item-header-title">
                      <t t-esc="itemLabelPlural"/>
                      [<t t-esc="'' + filteredIssues.length"/>]
                    </div>
                    <label class="allIssues">
                      <input id="showAllIssues" type="checkbox"
                        t-att-checked="state.allIssues"
                        t-on-input="(ev) => updateShowAllPreference(ev.target.checked)"/>
                      Show for everyone
                    </label>
                  </th>
                  <t t-if="state.dataSource === 'project.task'">
                    <th>Hours Spent</th>
                    <th>Remaining Hours</th>
                  </t>
                  <th class="project-col"><t t-esc="relationHeaderLabel"/></th>
                </t>
              </tr>
            </thead>
            <tbody>
              <t t-if="filteredIssues.length">
                <t t-foreach="filteredIssues" t-as="ir" t-key="ir.id">
                  <tr t-att-class="isActiveTimerItem(ir) ? 'active-row' : ''">
                    <td class="text-center px-2 td-btn action-col">
                      <t t-if="isActiveTimerItem(ir)">
                        <i class="text-danger fa fa-stop-circle action-btn pointer"
                          title="Stop timer and record the time to Odoo timesheets"
                          t-on-click="() => stopTimer(ir)"/>
                      </t>
                      <t t-elif="isHelpdeskSource &amp;&amp; helpdeskTimesheetBlocked(ir)">
                        <i class="fa fa-info-circle action-btn pointer text-info"
                          t-att-title="helpdeskTimesheetBlockMessage(ir)"
                          t-on-click="() => showHelpdeskTimesheetInfo(ir)"/>
                      </t>
                      <t t-else="">
                        <i class="fa fa-play-circle action-btn pointer"
                          title="Start the timer for the selected item"
                          t-on-click="() => startTimer(ir)"/>
                      </t>
                    </td>
                    <t t-if="isHelpdeskSource">
                      <t t-if="showHelpdeskTherpLink">
                        <td class="text-center" style="width:72px">
                          <t t-if="helpdeskTherpLinkHref(ir)">
                            <a t-att-href="helpdeskTherpLinkHref(ir)" target="_blank"
                              rel="noreferrer" class="btn btn-sm btn-outline-secondary"
                              title="Open linked Therp task">
                              <i class="fa fa-external-link"/>
                            </a>
                          </t>
                        </td>
                      </t>
                      <td class="priority-cell">
                        <t t-foreach="priorityStarsArr(ir.priority)" t-as="s" t-key="s">
                          <span class="fa fa-star checked"/>
                        </t>
                        <t t-foreach="priorityOutlineArr(ir.priority)" t-as="o" t-key="o">
                          <i class="fa fa-star-o"/>
                        </t>
                      </td>
                      <td class="issue-desc-cell" style="width:280px">
                        <ReadMore text="issueLabel(ir)" limit="55" href="issueHref(ir)"/>
                        <t t-if="showHelpdeskDescription &amp;&amp; helpdeskDescriptionText(ir)">
                          <div class="text-muted-soft small" style="margin-top:3px;line-height:1.3">
                            <ReadMore text="helpdeskDescriptionText(ir)" limit="70"/>
                          </div>
                        </t>
                      </td>
                      <td class="stage-cell">
                        <ReadMore text="(ir.stage_id &amp;&amp; ir.stage_id[1]) || ''" limit="14"/>
                      </td>
                      <t t-if="showHelpdeskAssignee">
                        <td style="width:120px">
                          <ReadMore text="relationLabel(helpdeskAssigneeValue(ir))" limit="22"/>
                        </td>
                      </t>
                      <t t-if="showHelpdeskHours">
                        <td style="width:88px">
                          <ReadMore text="formatHours(helpdeskHoursValue(ir))" limit="10"/>
                        </td>
                      </t>
                    </t>
                    <t t-else="">
                      <td class="priority-cell">
                        <t t-foreach="priorityStarsArr(ir.priority)" t-as="s" t-key="s">
                          <span class="fa fa-star checked"/>
                        </t>
                        <t t-foreach="priorityOutlineArr(ir.priority)" t-as="o" t-key="o">
                          <i class="fa fa-star-o"/>
                        </t>
                      </td>
                      <td class="stage-cell">
                        <ReadMore text="(ir.stage_id &amp;&amp; ir.stage_id[1]) || ''" limit="14"/>
                      </td>
                      <td class="issue-desc-cell">
                        <ReadMore text="issueLabel(ir)" limit="60" href="issueHref(ir)"/>
                      </td>
                      <t t-if="state.dataSource === 'project.task'">
                        <td class="hours-spent-cell">
                          <div class="hours-cell-inner">
                            <ReadMore text="formatHours(ir.effective_hours)" limit="10"/>
                            <i class="fa fa-list-alt pointer"
                              title="View Timesheets for this task"
                              t-on-click="() => openTimesheets(ir)"/>
                          </div>
                        </td>
                        <td>
                          <ReadMore text="formatHours(ir.remaining_hours)" limit="10"/>
                        </td>
                      </t>
                      <td class="project-cell">
                        <ReadMore text="relationLabel(resourceRelationValue(ir))" limit="22"/>
                      </td>
                    </t>
                  </tr>
                </t>
              </t>
              <t t-else="">
                <tr>
                  <td t-att-colspan="'' + tableColumnCount"
                    class="text-center text-danger">
                    No matching items are currently available
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>

        <div class="info-footer mx-3" style="padding:12px 16px 10px;">
          <div class="remote-info-list" style="font-size:12px;line-height:1.55;text-align:left;overflow-wrap:anywhere;word-break:break-word;">
            <div><b>Odoo:</b> <t t-esc="state.serverVersion || 'N/A'"/></div>
            <div><b>OWL:</b> <t t-esc="owlVersion"/></div>
            <div><b>Host:</b> <t t-esc="state.currentHost || '—'"/></div>
            <div><b>Database:</b> <t t-esc="state.currentDatabase || '—'"/></div>
            <div><b>Current User:</b> <t t-esc="(state.user &amp;&amp; state.user.display_name) || '—'"/></div>
            <div><b>Current Company:</b> <t t-esc="currentCompanyLabel"/></div>
            <div t-att-title="allowedCompanyLabels"><b>Allowed Companies:</b> <t t-esc="allowedCompanyLabels || '—'"/></div>
          </div>
        </div>
      </div>
    </div>
  </t>

</templates>
