                </select>
              </div>
              
              <div class="layout-pref-field" t-att-class="state.layoutSuggestedFields['table.minWidth'] ? 'layout-pref-field layout-pref-suggested' : 'layout-pref-field'">
                <label>Minimum table width (px)</label>
                <input type="number" step="1" inputmode="numeric" min="0" max="2400"
                  t-att-value="state.layoutPrefs.table.minWidth"
                  t-on-input="(ev) => { state.layoutPrefs.table.minWidth = ev.target.value; state.layoutError = ''; markLayoutFieldEdited('table.minWidth'); }"/>
