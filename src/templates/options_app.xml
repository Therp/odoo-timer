          <details class="layout-pref-section">
            <summary>Table Column Widths</summary>
            <div class="layout-pref-grid">
              
              <div class="layout-pref-field" t-att-class="state.layoutSuggestedFields['table.actionWidth'] ? 'layout-pref-field layout-pref-suggested' : 'layout-pref-field'">
