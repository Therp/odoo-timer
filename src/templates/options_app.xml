                </select>
              </div>
              <div class="layout-pref-field" t-att-class="state.layoutSuggestedFields['table.layoutMode'] ? 'layout-pref-field layout-pref-suggested' : 'layout-pref-field'">
                <label>Column sizing</label>
                <select t-att-value="state.layoutPrefs.table.layoutMode"
