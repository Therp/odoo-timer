          </details>

          <details class="layout-pref-section">
            <summary>Options Page</summary>
            <div class="layout-pref-grid">
              
              <div class="layout-pref-field">
                <label>Page font size (px)</label>
                <input type="number" step="1" inputmode="numeric" min="10" max="22"
                  t-att-value="state.layoutPrefs.options.pageFontSize"
                  t-on-input="(ev) => { state.layoutPrefs.options.pageFontSize = ev.target.value; state.layoutError = ''; }"/>
                
              </div>
              
              <div class="layout-pref-field">
                <label>Sidebar font size (px)</label>
                <input type="number" step="1" inputmode="numeric" min="10" max="22"
                  t-att-value="state.layoutPrefs.options.sidebarFontSize"
                  t-on-input="(ev) => { state.layoutPrefs.options.sidebarFontSize = ev.target.value; state.layoutError = ''; }"/>
                
              </div>
              
              <div class="layout-pref-field">
                <label>Remotes table font (px)</label>
                <input type="number" step="1" inputmode="numeric" min="10" max="22"
                  t-att-value="state.layoutPrefs.options.remotesTableFontSize"
                  t-on-input="(ev) => { state.layoutPrefs.options.remotesTableFontSize = ev.target.value; state.layoutError = ''; }"/>
                
              </div>
              
              <div class="layout-pref-field">
                <label>Remotes header font (px)</label>
                <input type="number" step="1" inputmode="numeric" min="10" max="22"
                  t-att-value="state.layoutPrefs.options.remotesHeaderFontSize"
                  t-on-input="(ev) => { state.layoutPrefs.options.remotesHeaderFontSize = ev.target.value; state.layoutError = ''; }"/>
                
              </div>
              
              <div class="layout-pref-field">
                <label>Remotes cell padding (px)</label>
                <input type="number" step="1" inputmode="numeric" min="0" max="24"
                  t-att-value="state.layoutPrefs.options.remotesCellPaddingY"
                  t-on-input="(ev) => { state.layoutPrefs.options.remotesCellPaddingY = ev.target.value; state.layoutError = ''; }"/>
                
              </div>
              
              <div class="layout-pref-field">
                <label>Remotes table minimum width (px)</label>
                <input type="number" step="1" inputmode="numeric" min="600" max="1800"
                  t-att-value="state.layoutPrefs.options.remotesMinWidth"
                  t-on-input="(ev) => { state.layoutPrefs.options.remotesMinWidth = ev.target.value; state.layoutError = ''; }"/>
                
              </div>
              <div class="layout-pref-field">
                <label>Remotes header wrapping</label>
                <select t-att-value="state.layoutPrefs.options.remotesHeaderWrap ? 'wrap' : 'nowrap'"
                  t-on-change="(ev) => { state.layoutPrefs.options.remotesHeaderWrap = ev.target.value === 'wrap'; state.layoutError = ''; }">
                  <option value="wrap">Wrap</option>
                  <option value="nowrap">No wrap</option>
                </select>
              </div>
            </div>
          </details>

          <div class="layout-pref-actions">
            <button type="button" class="btn btn-info" t-on-click="saveLayoutPreferences">
              <i class="fa fa-save"/> Save
            </button>
            <button type="button" class="btn btn-default" t-on-click="resetLayoutPreferences">
              <i class="fa fa-undo"/> Reset to source CSS defaults
            </button>
            <button type="button" class="btn btn-default" t-on-click="loadSuggestedLayoutSettings">
              <i class="fa fa-table"/> Try suggested settings
            </button>
          </div>

          <t t-if="state.layoutSuggestionActive">
            <div class="layout-suggestion-note">
              <i class="fa fa-lightbulb-o"/>
              <div>
                <strong>Suggested settings loaded.</strong>
                Review the blue-highlighted fields, then press <strong>Save</strong> to apply them.
                If you edit a highlighted field yourself, its suggestion highlight is removed automatically.
              </div>
            </div>
          </t></div>
      </div>
      <!-- ── Options / remotes page ──────────────────────────────────── -->
      <div
        class="options-box box"
        t-att-class="state.activePage === 'options' ? 'active_page' : 'inactive_page'"
      >
        <div class="form remote-options-form">
          <form t-on-submit.prevent="addRemote">

            <!-- [FIX #38] General Settings ──────────────────────────── -->
            <h4 class="remote-title text-info">General Settings</h4>
            <hr/>
            <div class="form-group" style="padding:0 2px;">
              <label class="general-setting-label"
                style="display:flex;align-items:center;gap:8px;margin:0;line-height:1.35;">
                <input
                  type="checkbox"
                  class="defaultCheckbox"
                  style="margin:0;position:static;flex:0 0 auto;"
                  t-att-checked="state.autoDownloadIssueTimesheet"
                  t-on-change="toggleAutoDownload"
                />
                <span>Auto Download Current Item Timesheet</span>
              </label>
              <p class="inline-help" style="margin:6px 0 0 24px;line-height:1.35;">
                Store the timesheet locally each time you stop the timer on an item.
              </p>
            </div>
            <hr/>

            <!-- Add Remote form ─────────────────────────────────────── -->
            <h4 class="remote-title text-info">Add Remote</h4>
            <hr/>

            <div class="form-group">
              <label for="remote-host">Odoo Host</label>
              <input
                type="text"
                class="form-control"
                id="remote-host"
                placeholder="https://your-odoo-host.example"
                t-att-value="state.form.remote_host"
                t-on-input="(ev) => state.form.remote_host = ev.target.value"
              />
            </div>

            <div class="form-group">
              <label for="remote-name">Display Name</label>
              <input
                type="text"
                class="form-control"
                id="remote-name"
                placeholder="Therp"
                t-att-value="state.form.remote_name"
                t-on-input="(ev) => state.form.remote_name = ev.target.value"
              />
            </div>

            <div class="form-group">
              <label for="remote-database">Odoo Database</label>
              <input
                type="text"
                class="form-control"
                id="remote-database"
                placeholder="someodoodatabase"
                t-att-value="state.form.remote_database"
                t-on-input="(ev) => state.form.remote_database = ev.target.value"
              />
            </div>

            <div class="form-group">
              <label class="label">Data Source</label>
              <ul class="data-source-list list-group">
                <li class="list-group-item">
                  <div class="form-check">
                    <input
                      class="form-check-input"
                      type="radio"
                      value="project.issue"
                      id="FromIssues"
                      t-att-checked="state.form.remote_datasrc === 'project.issue'"
                      t-on-change="() => state.form.remote_datasrc = 'project.issue'"
                    />
                    <label class="form-check-label" for="FromIssues">From Issues</label>
                  </div>
                </li>
                <li class="list-group-item">
                  <div class="form-check">
                    <input
                      class="form-check-input"
                      type="radio"
                      value="project.task"
                      id="FromTasks"
                      t-att-checked="state.form.remote_datasrc === 'project.task'"
                      t-on-change="() => state.form.remote_datasrc = 'project.task'"
                    />
                    <label class="form-check-label" for="FromTasks">From Tasks</label>
                  </div>
                </li>
                <li class="list-group-item">
                  <div class="form-check">
                    <input
                      class="form-check-input"
                      type="radio"
                      value="helpdesk.ticket"
                      id="FromHelpdeskTickets"
                      t-att-checked="state.form.remote_datasrc === 'helpdesk.ticket'"
                      t-on-change="() => state.form.remote_datasrc = 'helpdesk.ticket'"
                    />
                    <label class="form-check-label" for="FromHelpdeskTickets">From Helpdesk Tickets</label>
                  </div>
                </li>
              </ul>
            </div>

            <div class="form-group">
              <label for="remote-logo">Company Logo <span class="text-muted">(optional)</span></label>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <img t-att-src="formLogoSrc" alt="Remote logo preview"
                  style="width:76px;height:54px;object-fit:contain;border:1px solid #dbe3ea;border-radius:6px;background:#fff;padding:4px;"/>
                <div style="min-width:220px;flex:1;">
                  <input id="remote-logo" type="file" class="form-control"
                    accept="image/png,image/jpeg,image/webp,image/gif"
                    t-on-change="onRemoteLogoChange"
                  t-on-click="onRemoteLogoPickerClick"/>
                <p class="inline-help logo-file-help">Choose a company logo for this remote. When Options is still inside the toolbar popup, Browse first opens the full Options tab so the native file picker can stay open. Click Browse again in that tab, then choose PNG, JPEG, WebP, or GIF up to 512 KB. Use the Therp default logo button to remove a saved custom logo.</p>
                  <div style="margin-top:5px;font-size:11px;color:#7b8794;line-height:1.35;">
                    PNG, JPEG, WebP or GIF; maximum 512 KB.
                    <br/><b>Company logos are stored with each remote. If this Options page is running inside the extension popup, clicking Browse first opens the full Options tab so the browser file picker can stay open. Click Browse again in that tab to choose PNG, JPEG, WebP, or GIF up to 512 KB. Use the Therp default logo button to remove a saved custom logo.</b> if choosing a file closes the extension popup, open Inspect/DevTools for the popup first and then choose the logo.
                  </div>
                  <button type="button" class="btn btn-sm btn-default"
                    style="margin-top:7px;" t-on-click="clearRemoteLogo">
                    Use Therp default logo
                  </button>
                </div>
              </div>
            </div>
            <span class="caption-remotes">Controls</span>
            <div class="remotes-control-btns col-md-12 text-center text-info pointer">
              <i
                title="Add a remote host"
                class="fa fa-2x fa-plus-circle"
                t-on-click="addRemote"
              />
              <i
                title="Refresh list of remotes"
                class="fa fa-2x fa-refresh"
                t-on-click="loadRemotes"
              />
              <i
                title="View list of remotes"
                class="fa fa-2x fa-eye"
                t-on-click="() => state.showList = !state.showList"
              />
              <i
                title="Remove all remotes"
                class="fa fa-2x fa-minus-circle"
                t-on-click="removeAllRemotes"
              />
            </div>

            <t t-if="state.error">
              <div class="remote-error" t-out="state.error"/>
            </t>

          </form>

          <!-- Saved remotes table ──────────────────────────────────── -->
          <t t-if="state.showList and state.remotes.length">
            <div class="remotes-table-info">
              <table class="table table-bordered">
                <caption class="text-info caption-remotes">
                  List of Available Remotes
                </caption>
                <thead>
                  <tr>
                    <th scope="col" style="width:64px">Logo</th>
                    <th scope="col">Remote</th>
                    <th scope="col">Host</th>
                    <th scope="col">Database</th>
                    <th scope="col">Source</th>
                    <th scope="col">State</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <t
                    t-foreach="state.remotes"
                    t-as="remote"
                    t-key="remoteKey(remote)"
                  >
                    <tr>
                      <td class="text-center" style="width:64px">
                        <img t-att-src="remoteLogoSrc(remote)" alt="Remote logo"
                          style="width:48px;height:34px;object-fit:contain;background:#fff;border:1px solid #e2e8f0;border-radius:4px;padding:2px;"/>
                      </td>
                      <td class="text-info">
                        <ReadMore text="remote.name" limit="18"/>
                      </td>
                      <td>
                        <ReadMore text="remote.url" limit="25"/>
                      </td>
                      <td>
                        <ReadMore text="remote.database" limit="18"/>
                      </td>
                      <td>
                        <ReadMore text="remote.datasrc || 'project.issue'" limit="18"/>
                      </td>
                      <td>
                        <ReadMore text="remote.state || 'Inactive'" limit="18"/>
                      </td>
                      <td class="remote-row-actions">
                        <i
                          class="fa fa-pencil text-primary"
                          title="Edit remote"
                          t-on-click="() => editRemote(remote)"
                          style="margin-right: 10px; cursor: pointer;"
                        />
                        <i
                          class="fa fa-trash text-danger"
                          title="Remove remote"
                          t-on-click="() => removeRemote(remote)"
                          style="cursor: pointer;"
                        />
                      </td>
                    </tr>
                  </t>
                </tbody>
              </table>
            </div>
          </t>

        </div>
      </div>

    </div>
  </t>
</templates>
