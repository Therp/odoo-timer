<templates xml:space="preserve">
  <t t-name="PopupApp" owl="1">
    <div class="app-root">
      <div
        id="loader-container"
        t-att-class="state.view === 'loading' ? '' : 'hide'"
      >
        <div class="loader-card">
          <div class="loader-text" t-out="state.busyMessage"/>
          <div class="loader-subtext">
            Please wait — or grab a cup of coffee ☕
          </div>
          <i class="fa fa-cog fa-spin fa-5x"/>
        </div>
      </div>

      <div
        id="login"
        class="login-view"
        t-att-class="state.view === 'login' ? 'login-view' : 'login-view hide'"
      >
        <div class="popup-login-shell">
          <div class="form">
            <div class="logo">
              <img t-att-src="currentRemoteLogoSrc" alt="Remote logo"/>
            </div>

            <t t-if="state.bootError">
              <div>
                <p class="odooError" t-out="state.bootError"/>
              </div>
            </t>

            <t t-if="!state.remotes.length">
              <div class="container no-remotes-set">
                <div class="alert alert-warning">
                  Hello <span class="fun-man">😉</span>, you have not configured
                  any remotes. Open
                  <b><i class="fa fa-cogs"/> Options</b>
                  below and add one.
                </div>
              </div>
            </t>

            <t t-if="state.remotes.length">
              <form t-on-submit.prevent="login">
                <t t-if="state.loginError">
                  <p class="odooError" t-out="state.loginError"/>
                </t>

                <t t-if="!state.useExistingSession">
                  <input
                    type="text"
                    placeholder="Username"
                    t-att-value="state.username"
                    t-on-input="(ev) => state.username = ev.target.value"
                  />
                </t>

                <div class="password-field">
                  <t t-if="!state.useExistingSession">
                    <input
                      id="unique-password"
                      t-att-type="state.showPassword ? 'text' : 'password'"
                      placeholder="Password"
                      t-att-value="state.password"
                      t-on-input="(ev) => state.password = ev.target.value"
                    />
                  </t>

                  <t t-if="!state.useExistingSession">
                    <span
                      class="pass-viewer"
                      t-on-click="togglePassword"
                    >
                      <i
                        class="fa"
                        t-att-class="state.showPassword ? 'fa fa-eye-slash' : 'fa fa-eye'"
                      />
                    </span>
                  </t>
                </div>

                <select
                  id="remote-selection"
                  class="form-control"
                  t-on-change="(ev) => state.selectedRemoteIndex = ev.target.value"
                >
                  <t
                    t-foreach="state.remotes"
                    t-as="remote"
                    t-key="remoteKey(remote)"
                  >
                    <option
                      t-att-value="remote.__index"
                      t-att-selected="state.selectedRemoteIndex === remote.__index"
                      t-out="remoteOptionLabel(remote)"
                    />
                  </t>
                </select>

                <div class="checkbox">
                  <label>
                    <input
                      type="checkbox"
                      t-att-checked="state.useExistingSession"
                      t-on-change="toggleUseExistingSession"
                    />
                    Use Existing Session
                  </label>
                </div>

                <button class="login" type="submit">
                  Login
                  <t t-if="state.loginLoading">
                    <i class="fa fa-cog fa-spin"/>
                  </t>
                </button>

                <t t-if="currentRemote">
                  <div class="remote-info small-note">
                    Host:
                    <t t-out="currentRemote.url"/>
                    <span class="current-source-chip">
                      <t t-out="currentRemote.datasrc || 'project.issue'"/>
                    </span>
                  </div>
                </t>
              </form>
            </t>
          </div>
        </div>

        <div class="cta forgotpwd footer-app-opts login-footer-bar">
          <a href="options_main_page.html">
            <i class="fa fa-cogs"/> Options
          </a>
        </div>
      </div>

      <div
        id="wrapper"
        t-att-class="state.view === 'main' ? '' : 'hide'"
      >
        <t t-if="state.sourceError">
          <div class="odooError source-warning" t-out="state.sourceError"/>
        </t>
        <div class="toolbar-row">
          <input
            id="searchIssue"
            type="text"
            placeholder="Search by ID, name, user, priority, stage..."
            t-att-value="state.searchQuery"
            t-on-input="(ev) => state.searchQuery = ev.target.value"
          />
          <t t-if="isHelpdeskSource">
            <select
              id="helpdeskStageFilter"
              t-att-value="state.helpdeskStageFilter"
              t-on-change="(ev) => updateHelpdeskStageFilter(ev.target.value)"
            >
              <option value="">All stages</option>
              <t t-foreach="helpdeskStageOptions" t-as="stage" t-key="stage.id">
                <option
                  t-att-value="'' + stage.id"
                  t-att-selected="state.helpdeskStageFilter === '' + stage.id"
                ><t t-out="stage.name"/></option>
              </t>
            </select>
          </t>
          <select
            id="limitTo"
            t-model="state.limitTo"
            t-on-change="(ev) => updateLimitPreference(ev.target.value)"
          >
            <option value="10">10</option>
            <option value="15">15</option>
            <option value="25">25</option>
            <option value="">All</option>
          </select>
        </div>

        <div class="container footer top-actions">
          <div class="row">
            <div class="mx-3 col-md-12 footer-btns pointer">
              <i
                class="fa fa-download fa-2x"
                title="Download current month timesheet"
                t-on-click="downloadCurrentMonthTimesheets"
              />
              <i
                class="fa fa-hand-o-left fa-2x"
                title="Switch between remotes"
                t-on-click="switchBetweenRemotes"
              />
              <i
                class="fa fa-refresh fa-2x"
                title="Refresh current items"
                t-on-click="refreshAll"
              />
              <i
                class="fa fa-clock-o fa-2x"
                title="Discard the active timer"
                t-on-click="resetTimer"
              />
              <i
                class="fa fa-sign-out fa-2x"
                title="Log out"
                t-on-click="logout"
              />
              <a
                href="options_main_page.html"
                class="options-btn"
                title="Go To options"
              >
                <i class="fa fa-cogs fa-2x"/>
              </a>
            </div>
          </div>
        </div>

        <div class="table-scroll">
          <table
            id="table-task-issues"
            class="table table-responsive-sm table-bordered table-fixed"
          >
            <thead>
              <tr>
                <th class="action-col">
                  <div/>
                  <t t-if="state.timerStartIso">
                    <span class="startTimeCount" t-out="formattedTimer"/>
                  </t>
                </th>

                <t t-if="isHelpdeskSource">
                  <t t-if="showHelpdeskTherpLink">
                    <th class="text-center" style="width:72px">Therp Task</th>
                  </t>
                  <th class="priority-col">Priority</th>
                  <th class="item-col" style="width:280px">
                    <div class="item-header-title">
                      <t t-out="itemLabelPlural"/> [<t t-out="filteredIssues.length"/>]
                    </div>
                    <label class="allIssues">
                      <input
                        id="showAllIssues"
                        type="checkbox"
                        t-att-checked="state.allIssues"
                        t-on-input="(ev) => updateShowAllPreference(ev.target.checked)"
                      />
                      Show for everyone
                    </label>
                  </th>
                  <th class="stage-col">Stage</th>
                  <t t-if="showHelpdeskAssignee">
                    <th style="width:120px">Assigned To</th>
                  </t>
                  <t t-if="showHelpdeskHours">
                    <th class="text-center" style="width:88px">Time Spent</th>
                  </t>
                </t>

                <t t-else="">
                  <th class="priority-col">Priority</th>
                  <th class="stage-col">Stage</th>
                  <th class="item-col">
                    <div class="item-header-title">
                      <t t-out="itemLabelPlural"/> [<t t-out="filteredIssues.length"/>]
                    </div>
                    <label class="allIssues">
                      <input
                        id="showAllIssues"
                        type="checkbox"
                        t-att-checked="state.allIssues"
                        t-on-input="(ev) => updateShowAllPreference(ev.target.checked)"
                      />
                      Show for everyone
                    </label>
                  </th>
                  <t t-if="state.dataSource === 'project.task'">
                    <th class="text-center">Hours Spent</th>
                    <th class="text-center">Hours Left</th>
                  </t>
                  <th class="project-col" t-out="relationHeaderLabel"/>
                </t>
              </tr>
            </thead>

            <tbody>
              <t t-if="filteredIssues.length">
                <t t-foreach="filteredIssues" t-as="issue" t-key="issue.id">
                  <tr t-att-class="isActiveTimerItem(issue) ? 'active-row' : ''">
                    <td class="text-center px-2 td-btn action-col">
                      <t t-if="!state.activeTimerId">
                        <t t-if="isHelpdeskSource &amp;&amp; helpdeskTimesheetBlocked(issue)">
                          <i
                            class="fa fa-info-circle action-btn pointer text-info"
                            t-att-title="helpdeskTimesheetBlockMessage(issue)"
                            t-on-click="() => showHelpdeskTimesheetInfo(issue)"
                          />
                        </t>
                        <t t-else="">
                          <i
                            class="fa fa-play-circle action-btn pointer"
                            title="Start the timer for the selected item"
                            t-on-click="() => startTimer(issue)"
                          />
                        </t>
                      </t>
                      <t t-if="isActiveTimerItem(issue)">
                        <i
                          class="text-danger fa fa-stop-circle action-btn pointer"
                          title="Stop timer and record the time to Odoo timesheets"
                          t-on-click="() => stopTimer(issue)"
                        />
                      </t>
                    </td>

                    <t t-if="isHelpdeskSource">
                      <t t-if="showHelpdeskTherpLink">
                        <td class="text-center" style="width:72px">
                          <t t-if="helpdeskTherpLinkHref(issue)">
                            <a
                              t-att-href="helpdeskTherpLinkHref(issue)"
                              target="_blank"
                              rel="noreferrer"
                              class="btn btn-sm btn-outline-secondary"
                              title="Open linked Therp task"
                            >
                              <i class="fa fa-external-link"/>
                            </a>
                          </t>
                        </td>
                      </t>

                      <td class="priority-cell">
                        <t t-if="issue.priority_level.length">
                          <t
                            t-foreach="issue.priority_level"
                            t-as="priority"
                            t-key="priority + '_' + issue.id"
                          >
                            <span class="fa fa-star checked"/>
                          </t>
                        </t>
                        <t t-if="!issue.priority_level.length">
                          <i class="fa fa-star-o"/>
                        </t>
                      </td>

                      <td class="issue-desc-cell" style="width:280px">
                        <ReadMore
                          text="issueLabel(issue)"
                          limit="55"
                          href="issueHref(issue)"
                        />
                        <t t-if="showHelpdeskDescription &amp;&amp; helpdeskDescriptionText(issue)">
                          <div class="text-muted-soft small" style="margin-top:3px;line-height:1.3">
                            <ReadMore text="helpdeskDescriptionText(issue)" limit="70"/>
                          </div>
                        </t>
                      </td>

                      <td class="stage-cell">
                        <ReadMore text="relationLabel(issue.stage_id)" limit="15"/>
                      </td>

                      <t t-if="showHelpdeskAssignee">
                        <td style="width:120px">
                          <ReadMore text="relationLabel(helpdeskAssigneeValue(issue))" limit="22"/>
                        </td>
                      </t>

                      <t t-if="showHelpdeskHours">
                        <td class="text-center" style="width:88px">
                          <ReadMore text="formatHours(helpdeskHoursValue(issue))" limit="10"/>
                        </td>
                      </t>
                    </t>

                    <t t-else="">
                      <td class="priority-cell">
                        <t t-if="issue.priority_level.length">
                          <t
                            t-foreach="issue.priority_level"
                            t-as="priority"
                            t-key="priority + '_' + issue.id"
                          >
                            <span class="fa fa-star checked"/>
                          </t>
                        </t>
                        <t t-if="!issue.priority_level.length">
                          <i class="fa fa-star-o"/>
                        </t>
                      </td>
                      <td class="stage-cell">
                        <ReadMore text="relationLabel(issue.stage_id)" limit="15"/>
                      </td>
                      <td class="issue-desc-cell">
                        <ReadMore text="issueLabel(issue)" limit="70" href="issueHref(issue)"/>
                      </td>
                      <t t-if="state.dataSource === 'project.task'">
                        <td class="text-center">
                          <ReadMore text="normalizeText(formatHours(issue.effective_hours))" limit="9"/>
                        </td>
                        <td class="text-center">
                          <ReadMore text="normalizeText(formatHours(issue.remaining_hours))" limit="9"/>
                        </td>
                      </t>
                      <td class="project-cell">
                        <ReadMore text="relationLabel(resourceRelationValue(issue))" limit="22"/>
                      </td>
                    </t>
                  </tr>
                </t>
              </t>

              <t t-if="!filteredIssues.length">
                <tr>
                  <td class="text-center text-danger" t-att-colspan="tableColumnCount">
                    No matching items are currently available
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>

        <div class="container footer info-footer" style="padding:12px 8px 10px;">
          <div class="text-center" style="margin-bottom:8px;">
            <img t-att-src="currentRemoteLogoSrc" alt="Remote"
              style="width:72px;height:48px;object-fit:contain;background:#fff;border:1px solid #e2e8f0;border-radius:6px;padding:4px;"/>
            <div style="margin-top:4px;font-size:12px;font-weight:600;">
              <t t-out="(currentRemote &amp;&amp; (currentRemote.name || currentRemote.database)) || 'Odoo'"/>
              <span class="current-source-chip" style="margin-left:5px;">
                <t t-out="currentDataSourceLabel"/>
              </span>
            </div>
          </div>
          <div class="row remote-info-block" style="display:flex;flex-wrap:wrap;font-size:12px;line-height:1.35;">
            <div class="col-4 text-center" style="flex:0 0 33.333%;max-width:33.333%;padding:5px;word-break:break-word;">
              <b>Odoo</b><br/><span class="remote-value" t-out="state.serverVersion || 'Unknown'"/>
            </div>
            <div class="col-4 text-center" style="flex:0 0 33.333%;max-width:33.333%;padding:5px;word-break:break-word;">
              <b>Database</b><br/><span class="remote-value" t-out="state.currentDatabase || '-'"/>
            </div>
            <div class="col-4 text-center" style="flex:0 0 33.333%;max-width:33.333%;padding:5px;word-break:break-word;">
              <b>Host</b><br/><span class="remote-value" t-out="state.currentHost || '-'"/>
            </div>
            <div class="col-4 text-center" style="flex:0 0 33.333%;max-width:33.333%;padding:5px;word-break:break-word;">
              <b>User</b><br/><span class="remote-value" t-out="state.user ? state.user.display_name : '-'"/>
            </div>
            <div class="col-4 text-center" style="flex:0 0 33.333%;max-width:33.333%;padding:5px;word-break:break-word;">
              <b>Current Company</b><br/><span class="remote-value" t-out="currentCompanyLabel"/>
            </div>
            <div class="col-4 text-center" style="flex:0 0 33.333%;max-width:33.333%;padding:5px;word-break:break-word;" t-att-title="allowedCompanyLabels">
              <b>Allowed Companies</b><br/><span class="remote-value" t-out="allowedCompanySummary"/>
            </div>
          </div>
          <div class="text-center text-muted" style="font-size:10px;margin-top:3px;">
            OWL <span t-out="state.odooOWLVersion || 'Unknown'"/>
          </div>
        </div>
      </div>
    </div>
  </t>
</templates>
